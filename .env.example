# ================================================================
# MAHAKAL SWARN BUILDER - ENVIRONMENT VARIABLES
# ================================================================
# Add these values to your local .env.local and the Vercel project's
# Environment Variables. Never commit actual secrets.

# Neon Postgres connection string (use the pooled connection string from Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Initial Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_random_password_here

# Cryptographic Session Secret (generate a unique random value of 32+ characters)
ADMIN_SESSION_SECRET=replace_with_a_unique_random_secret
